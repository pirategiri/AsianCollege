// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id                  String    @id @default(cuid())
  name                String
  status              String // On Track, At Risk, Delayed, Completed
  startDate           DateTime
  targetCompletionDate DateTime
  progress            Float
  owner               String
  team                String
  blockers            String?
  category            Category? @relation(fields: [categoryId], references: [id])
  categoryId          String?
  tasks               Task[]
  risks               Risk[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  title       String
  description String?
  status      String
  dueDate     DateTime?
  assigneeId  String?
  assignee    Resource? @relation(fields: [assigneeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Resource {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String // Dev, QA, BA, PM
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique // Product, Compliance, Enhancement, Integration, Operations
  projects Project[]
}

model Risk {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  description String
  probability Int // 1-5
  impact      Int // 1-5
  mitigation  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Issue {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String // Bug, Task, Story, Blocker
  status      String
  priority    String
  age         Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  jiraConnections JiraConnection[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JiraConnection {
  id        String   @id @default(cuid())
  domain    String
  email     String
  apiToken  String
  boards    String[]
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DataImportLog {
  id        String   @id @default(cuid())
  source    String // jira, excel, csv
  fileName  String?
  status    String // success, failure
  message   String?
  createdAt DateTime @default(now())
}

model NormalizedIssueData {
  id                  String    @id @default(cuid())
  source              String // jira, excel
  externalId          String // Jira issue key or Excel row ID
  project             String
  title               String
  description         String?
  status              String
  type                String    // Bug, Task, Story, Blocker
  priority            String
  assignee            String?
  reporter            String?
  storyPoints         Float?
  sprint              String?
  epic                String?
  labels              String[]
  createdAt           DateTime
  updatedAt           DateTime
  resolvedAt          DateTime?
  targetStartDate     DateTime?
  targetEndDate       DateTime?
  actualStartDate     DateTime?
  actualEndDate       DateTime?
}
